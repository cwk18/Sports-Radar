    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT jsonb_build_object('chat_id',u.chat_id,'mode','daily',\n 'prefs',jsonb_agg(jsonb_build_object('sport',f.sport,'team_key',f.team_key,'label',f.label,'aliases',f.aliases) ORDER BY f.sport,f.label)) AS context\nFROM sports_radar.users u JOIN sports_radar.follows f ON f.chat_id=u.chat_id\nWHERE u.daily_enabled AND NOT EXISTS (\n SELECT 1 FROM sports_radar.deliveries d WHERE d.chat_id=u.chat_id AND d.local_date=(now() AT TIME ZONE 'Europe/Paris')::date\n) GROUP BY u.chat_id;",
